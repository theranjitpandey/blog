---
export const prerender = false;

import MainGridLayout from "@layouts/MainGridLayout.astro";
import { supabase } from "@lib/supabase";
import UpdateCard from "@components/updates/UpdateCard.astro";
import UpdateComposer from "@components/updates/UpdateComposer.astro";
import UpdatesClientScript from "@components/updates/UpdatesClientScript.astro";

const { data: updates, error } = await supabase
	.from("updates")
	.select("*")
	.order("created_at", { ascending: false })
	.limit(50);

const ids = (updates ?? []).map((u) => u.id);
const { data: allComments } =
	ids.length > 0
		? await supabase
				.from("update_comments")
				.select("*")
				.in("update_id", ids)
				.order("created_at", { ascending: true })
		: { data: [] };

const commentsByUpdate = new Map<string, typeof allComments>();
for (const c of allComments ?? []) {
	const list = commentsByUpdate.get(c.update_id) ?? [];
	list.push(c);
	commentsByUpdate.set(c.update_id, list);
}
---

<MainGridLayout title="Admin">
	<div class="flex items-center justify-between mb-2 px-1">
		<div class="font-bold text-xl text-90">Post karein</div>
		<form action="/api/auth/logout/" method="post" id="logout-form">
			<button type="submit" class="btn-plain rounded-lg px-3 h-9 text-sm active:scale-95">Logout</button>
		</form>
	</div>

	<UpdateComposer />

	{error && <div class="text-red-500 px-2">Load nahi ho paaya: {error.message}</div>}

	{(updates ?? []).map((u) => (
		<UpdateCard
			id={u.id}
			content={u.content}
			image_url={u.image_url}
			likes_count={u.likes_count}
			comments_count={u.comments_count}
			created_at={u.created_at}
			liked={false}
			isAdmin={true}
			comments={commentsByUpdate.get(u.id) ?? []}
		/>
	))}

	<UpdatesClientScript />
</MainGridLayout>

<script>
	document.getElementById("logout-form")?.addEventListener("submit", async (e) => {
		e.preventDefault();
		await fetch("/api/auth/logout/", { method: "POST" });
		window.location.href = "/admin/login/";
	});
</script>
